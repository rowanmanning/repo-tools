{
  "name": "@rowanmanning/npm-workspaces",
  "version": "2.1.0",
  "type": "module",
  "description": "Get a list of all the npm workspaces found in a package lock file",
  "keywords": [],
  "author": "Rowan Manning (https://rowanmanning.com/)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rowanmanning/repo-tools.git",
    "directory": "packages/npm-workspaces"
  },
  "homepage": "https://github.com/rowanmanning/repo-tools/tree/main/packages/npm-workspaces#readme",
  "bugs": "https://github.com/rowanmanning/repo-tools/issues",
  "license": "MIT",
  "engines": {
    "node": "22.x || 24.x"
  },
  "scripts": {
    "build": "rm -rf dist && tsc",
    "test": "npm run test:unit && npm run test:end-to-end",
    "test:unit": "node --test --experimental-test-module-mocks --experimental-test-coverage --test-coverage-exclude '**/*.test.ts' --test-coverage-branches=100 --test-coverage-functions=100 --test-coverage-lines=100 'test/unit/**/*.test.ts'",
    "test:end-to-end": "node --test 'test/end-to-end/**/*.test.ts'"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "./index.d.ts",
  "main": "./index.js",
  "files": [
    "dist"
  ],
  "dependencies": {
    "@rowanmanning/package-json": "^2.1.0"
  }
}
