{
  "name": "@rowanmanning/repo-tools",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "description": "Various libraries to help with managing repos",
  "author": "Rowan Manning (https://rowanmanning.com/)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rowanmanning/repo-tools.git"
  },
  "homepage": "https://github.com/rowanmanning/repo-tools",
  "bugs": "https://github.com/rowanmanning/repo-tools/issues",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": "22.x || 24.x"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "verify": "biome check",
    "test": "npm run test --workspaces --if-present",
    "test:unit": "npm run test:unit --workspaces --if-present",
    "test:end-to-end": "npm run test:end-to-end --workspaces --if-present",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^19.8.1",
    "@rowanmanning/biome-config": "^3.1.0",
    "@types/node": "^25.9.5",
    "husky": "^9.1.7",
    "typescript": "^6.0.1-rc"
  },
  "volta": {
    "node": "22.22.0"
  }
}
